{
  "meta": {
    "name": "看得见的声音 - 四步反馈评测样本集 V1",
    "author": "Z3 周安来",
    "date": "2026-09-20",
    "week": "第3周",
    "purpose": "用于评测「结构化诊断 → 自然语言四步反馈」的生成质量，服务 Z2 提示词模板 V1 及后续 LLM 话术迭代。",
    "input_schema": "input 字段与 /api/audio/analyze 返回的 data 对齐（unit/target/recognized_text/detected_tone/tone_score/f0_mean/f0_std/fluency/quality/phonemes），作为提示词模板的标准输入。",
    "eval_dimensions": ["四步完整性", "准确性", "自然度", "安全性", "鼓励性"],
    "notes": "自然度、鼓励性两个维度暂无法全自动，需人工评审；四步完整性/准确性/安全性/类别命中已由 eval_scorer.py 自动化。"
  },
  "samples": [
    {
      "id": "samp_tone_001",
      "scene": "基频缺失",
      "description": "语音过弱/过短/噪声大，提取不到有效基频，无法评估声调",
      "input": {
        "unit": "ma1",
        "target": { "pinyin": "ma1", "initial": "m", "final": "a", "tone": 1 },
        "recognized_text": "ma",
        "detected_tone": 0,
        "tone_score": 0.0,
        "f0_mean": 0.0,
        "f0_std": 0.0,
        "fluency": 78.0,
        "quality": { "passed": true, "summary": "录音质量良好", "items": [] },
        "phonemes": [
          { "phoneme": "声母", "expected": "m", "detected": "m", "score": 100 },
          { "phoneme": "韵母", "expected": "a", "detected": "a", "score": 100 },
          { "phoneme": "声调", "expected": "第一声", "detected": "依据F0曲线判定", "score": 60 }
        ]
      },
      "expected": {
        "category": "tone",
        "level": "error",
        "must_mention": ["基频"],
        "forbidden": ["构音障碍", "病理"]
      }
    },
    {
      "id": "samp_tone_002",
      "scene": "声调识别错",
      "description": "目标 ma1 被识别为第三声（ma3）",
      "input": {
        "unit": "ma1",
        "target": { "pinyin": "ma1", "initial": "m", "final": "a", "tone": 1 },
        "recognized_text": "ma3",
        "detected_tone": 3,
        "tone_score": 20.0,
        "f0_mean": 180.0,
        "f0_std": 30.0,
        "fluency": 88.0,
        "quality": { "passed": true, "summary": "录音质量良好", "items": [] },
        "phonemes": [
          { "phoneme": "声母", "expected": "m", "detected": "m", "score": 100 },
          { "phoneme": "韵母", "expected": "a", "detected": "a", "score": 100 },
          { "phoneme": "声调", "expected": "第一声", "detected": "第三声", "score": 0 }
        ]
      },
      "expected": {
        "category": "tone",
        "level": "error",
        "must_mention": ["第三声", "第一声"],
        "forbidden": ["构音障碍", "病理"]
      }
    },
    {
      "id": "samp_tone_003",
      "scene": "曲线形状偏差",
      "description": "声调识别正确，但 F0 曲线形状与标准声调偏离较大",
      "input": {
        "unit": "ma1",
        "target": { "pinyin": "ma1", "initial": "m", "final": "a", "tone": 1 },
        "recognized_text": "ma1",
        "detected_tone": 1,
        "tone_score": 48.0,
        "f0_mean": 200.0,
        "f0_std": 28.0,
        "fluency": 85.0,
        "quality": { "passed": true, "summary": "录音质量良好", "items": [] },
        "phonemes": [
          { "phoneme": "声母", "expected": "m", "detected": "m", "score": 100 },
          { "phoneme": "韵母", "expected": "a", "detected": "a", "score": 100 },
          { "phoneme": "声调", "expected": "第一声", "detected": "第一声", "score": 100 }
        ]
      },
      "expected": {
        "category": "tone",
        "level": "error",
        "must_mention": ["偏差"],
        "forbidden": ["构音障碍", "病理"]
      }
    },
    {
      "id": "samp_tone_004",
      "scene": "声调轻微偏差",
      "description": "声调基本正确，但与标准存在轻微偏差（warning 级）",
      "input": {
        "unit": "ma1",
        "target": { "pinyin": "ma1", "initial": "m", "final": "a", "tone": 1 },
        "recognized_text": "ma1",
        "detected_tone": 1,
        "tone_score": 70.0,
        "f0_mean": 205.0,
        "f0_std": 18.0,
        "fluency": 88.0,
        "quality": { "passed": true, "summary": "录音质量良好", "items": [] },
        "phonemes": [
          { "phoneme": "声母", "expected": "m", "detected": "m", "score": 100 },
          { "phoneme": "韵母", "expected": "a", "detected": "a", "score": 100 },
          { "phoneme": "声调", "expected": "第一声", "detected": "第一声", "score": 100 }
        ]
      },
      "expected": {
        "category": "tone",
        "level": "warning",
        "must_mention": ["轻微偏差"],
        "forbidden": ["构音障碍", "病理"]
      }
    },
    {
      "id": "samp_tone_005",
      "scene": "声调优秀",
      "description": "声调曲线与标准高度一致，应给出鼓励性建议",
      "input": {
        "unit": "ma1",
        "target": { "pinyin": "ma1", "initial": "m", "final": "a", "tone": 1 },
        "recognized_text": "ma1",
        "detected_tone": 1,
        "tone_score": 92.0,
        "f0_mean": 200.0,
        "f0_std": 10.0,
        "fluency": 90.0,
        "quality": { "passed": true, "summary": "录音质量良好", "items": [] },
        "phonemes": [
          { "phoneme": "声母", "expected": "m", "detected": "m", "score": 100 },
          { "phoneme": "韵母", "expected": "a", "detected": "a", "score": 100 },
          { "phoneme": "声调", "expected": "第一声", "detected": "第一声", "score": 100 }
        ]
      },
      "expected": {
        "category": "tone",
        "level": "suggestion",
        "must_mention": ["优秀"],
        "forbidden": ["构音障碍", "病理"]
      }
    },
    {
      "id": "samp_pron_001",
      "scene": "声母错",
      "description": "目标 ba1 的声母 b 被发成 p",
      "input": {
        "unit": "ba1",
        "target": { "pinyin": "ba1", "initial": "b", "final": "a", "tone": 1 },
        "recognized_text": "pa1",
        "detected_tone": 1,
        "tone_score": 90.0,
        "f0_mean": 200.0,
        "f0_std": 10.0,
        "fluency": 88.0,
        "quality": { "passed": true, "summary": "录音质量良好", "items": [] },
        "phonemes": [
          { "phoneme": "声母", "expected": "b", "detected": "p", "score": 0 },
          { "phoneme": "韵母", "expected": "a", "detected": "a", "score": 100 },
          { "phoneme": "声调", "expected": "第一声", "detected": "第一声", "score": 100 }
        ]
      },
      "expected": {
        "category": "pronunciation",
        "level": "error",
        "must_mention": ["声母", "b", "p"],
        "forbidden": ["构音障碍", "病理"]
      }
    },
    {
      "id": "samp_pron_002",
      "scene": "韵母错",
      "description": "目标 ma1 的韵母 a 被发成 e",
      "input": {
        "unit": "ma1",
        "target": { "pinyin": "ma1", "initial": "m", "final": "a", "tone": 1 },
        "recognized_text": "me1",
        "detected_tone": 1,
        "tone_score": 90.0,
        "f0_mean": 200.0,
        "f0_std": 10.0,
        "fluency": 88.0,
        "quality": { "passed": true, "summary": "录音质量良好", "items": [] },
        "phonemes": [
          { "phoneme": "声母", "expected": "m", "detected": "m", "score": 100 },
          { "phoneme": "韵母", "expected": "a", "detected": "e", "score": 0 },
          { "phoneme": "声调", "expected": "第一声", "detected": "第一声", "score": 100 }
        ]
      },
      "expected": {
        "category": "pronunciation",
        "level": "error",
        "must_mention": ["韵母", "e"],
        "forbidden": ["构音障碍", "病理"]
      }
    },
    {
      "id": "samp_fluency_001",
      "scene": "流利度低",
      "description": "发音存在明显停顿或拖音，流畅度偏低",
      "input": {
        "unit": "ma1",
        "target": { "pinyin": "ma1", "initial": "m", "final": "a", "tone": 1 },
        "recognized_text": "ma1",
        "detected_tone": 1,
        "tone_score": 90.0,
        "f0_mean": 200.0,
        "f0_std": 10.0,
        "fluency": 50.0,
        "quality": { "passed": true, "summary": "录音质量良好", "items": [] },
        "phonemes": [
          { "phoneme": "声母", "expected": "m", "detected": "m", "score": 100 },
          { "phoneme": "韵母", "expected": "a", "detected": "a", "score": 100 },
          { "phoneme": "声调", "expected": "第一声", "detected": "第一声", "score": 100 }
        ]
      },
      "expected": {
        "category": "fluency",
        "level": "warning",
        "must_mention": ["停顿"],
        "forbidden": ["构音障碍", "病理"]
      }
    },
    {
      "id": "samp_quality_001",
      "scene": "录音质量警告",
      "description": "发音本身正确，但录音音量偏低，需给出环境提示",
      "input": {
        "unit": "ba1",
        "target": { "pinyin": "ba1", "initial": "b", "final": "a", "tone": 1 },
        "recognized_text": "ba1",
        "detected_tone": 1,
        "tone_score": 90.0,
        "f0_mean": 200.0,
        "f0_std": 10.0,
        "fluency": 90.0,
        "quality": {
          "passed": true,
          "summary": "录音可用，但存在可改进项",
          "items": [
            { "name": "音量", "key": "volume", "status": "warn", "message": "音量偏低（-35dBFS），建议靠近麦克风" }
          ]
        },
        "phonemes": [
          { "phoneme": "声母", "expected": "b", "detected": "b", "score": 100 },
          { "phoneme": "韵母", "expected": "a", "detected": "a", "score": 100 },
          { "phoneme": "声调", "expected": "第一声", "detected": "第一声", "score": 100 }
        ]
      },
      "expected": {
        "category": "quality",
        "level": "warning",
        "must_mention": ["音量"],
        "forbidden": ["构音障碍", "病理"]
      }
    }
  ]
}
